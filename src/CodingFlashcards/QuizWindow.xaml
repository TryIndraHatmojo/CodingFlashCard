<Window Style="{StaticResource {x:Type Window}}" x:Class="CodingFlashcards.QuizWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Latihan · Coding Flashcards" Width="820" Height="850" MinWidth="600" MinHeight="560" WindowStartupLocation="CenterScreen" Closing="ClosingQuiz">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><TextBlock Text="LATIHAN HARI INI" FontWeight="Bold" Foreground="#3759D7"/><TextBlock x:Name="TimerText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold"/></DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock x:Name="ProgressText" Foreground="#65708A" Margin="0,0,0,12"/>
   <TextBlock x:Name="PromptText" Text="Menyiapkan latihan…" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <TextBox x:Name="CodeText" Style="{StaticResource CodeBlock}" Visibility="Collapsed"/>
   <StackPanel x:Name="OptionsPanel" Margin="0,12"/>
   <Border x:Name="FeedbackBorder" Background="White" Padding="18" Margin="0,12" Visibility="Collapsed"><TextBlock x:Name="FeedbackText" TextWrapping="Wrap" LineHeight="23" FontFamily="Consolas"/></Border>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#65708A" Margin="0,8"/>
  </StackPanel></ScrollViewer>
  <WrapPanel Grid.Row="2" Margin="0,18,0,0"><Button x:Name="AnswerButton" Content="Periksa jawaban" Click="Answer" IsEnabled="False"/><Button x:Name="NextButton" Content="Berikutnya →" Click="Next" Visibility="Collapsed"/><Button x:Name="RetryButton" Content="Coba lagi" Click="Retry" Visibility="Collapsed"/><Button x:Name="CacheButton" Content="Latihan ulang dari cache" Click="UseCache" Visibility="Collapsed"/><Button Content="Settings" Click="OpenSettings"/><Button Content="Tutup" Click="CloseQuiz"/></WrapPanel>
 </Grid>
</Window>
