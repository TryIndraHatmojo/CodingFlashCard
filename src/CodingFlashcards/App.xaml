<Application x:Class="CodingFlashcards.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#3759D7"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#F4F6FB"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,4,10,4"/><Setter Property="Background" Value="#E8EDFF"/><Setter Property="Foreground" Value="#223568"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,15,7"/></Style>
  <Style x:Key="CodeBlock" TargetType="TextBox"><Setter Property="IsReadOnly" Value="True"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="15"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="MaxHeight" Value="330"/><Setter Property="Padding" Value="16"/><Setter Property="Background" Value="#EDF1FA"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Application.Resources>
</Application>
